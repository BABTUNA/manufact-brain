# Crusoe Managed Inference (https://console.crusoecloud.com → Intelligence Foundry → API keys)
CRUSOE_API_KEY=
# Optional model overrides; see lib/config.js for the defaults
# EXPLORER_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B
# JUDGE_MODEL=google/gemma-4-31b-it
# FAST_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

PORT=8787
PUBLIC_URL=http://localhost:8787
EXPLORE_AGENTS=3

# Supabase project (Postgres, Storage for screenshots, Realtime for the live pages)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the brain keeper sends as x-keeper-token; also guards POST /brain/:site/reset
KEEPER_TOKEN=
